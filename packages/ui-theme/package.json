{
  "name": "@silveralcid/ui-theme",
  "version": "0.1.0",
  "description": "Optional UI tokens and Mantine theme reference for projects using the universal repo template",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./base.css": "./base.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens.css",
    "base.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@mantine/core": "^7.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@mantine/core": "^7.0.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silveralcid/universal-repo-template.git",
    "directory": "packages/ui-theme"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
